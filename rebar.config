{minimum_otp_vsn, "27"}.

{erl_opts, [debug_info]}.

{deps, []}.

{plugins, [rebar3_hex]}.

{cover_export_enabled, true}.

{project_plugins, [erlfmt, rebar3_ex_doc]}.
{erlfmt, [write]}.

{ex_doc, [
    {source_url, <<"https://github.com/personnummer/erlang">>},
    {extras, [
        <<"README.md">>,
        <<"CHANGELOG.md">>,
        <<"LICENSE">>
    ]},
    {main, <<"readme">>}
]}.

{hex, [{doc, #{provider => ex_doc}}]}.

{dialyzer, [{plt_extra_apps, [eunit]}]}.
